 /**
+ * The user's GDevelop credit balance, or 0 when the limits are not loaded
+ * or the response is partial.
+ *
+ * `getUserLimits` only validates that the top-level `capabilities` key exists,
+ * so `credits.userBalance.amount` is not guaranteed at runtime even though
+ * `Limits` declares it. Reading it behind a top-level `limits ?` check alone
+ * throws during render if the nested objects are missing.
+ */
+export const getAvailableCredits = (limits: ?Limits): number => {
+  const credits = limits && limits.credits;
+  const userBalance = credits && credits.userBalance;
+  const amount = userBalance && userBalance.amount;
+  return typeof amount === 'number' ? amount : 0;
+};
+
