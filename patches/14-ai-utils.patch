+const searchLocalDocumentation = (query: string): ?Object => {
+  const gdGlobal = typeof global !== 'undefined' ? (global: any).gd : null;
+  if (
+    !gdGlobal ||
+    !gdGlobal.JsPlatform ||
+    !gdGlobal.JsPlatform.get ||
+    !gdGlobal.asPlatform
