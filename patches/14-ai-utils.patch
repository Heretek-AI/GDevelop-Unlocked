+const searchInstructionsInMap = (
+  instructionsMap: any,
+  kind: 'action' | 'condition',
+  extName: string,
+  targetName: string,
+  queryWords: Array<string>,
+  matches: Array<Object>,
+  maxMatches: number
+) => {
+  if (!instructionsMap) return;
+  const types = instructionsMap.keys();
+  for (let j = 0; j < types.size(); ++j) {
+    if (matches.length >= maxMatches) break;
+    const type = types.at(j);
+    const metadata = instructionsMap.get(type);
+    if (!metadata || metadata.isHidden()) continue;
+    const fullName = metadata.getFullName() || '';
+    const desc = metadata.getDescription() || '';
+    const haystack = `${type} ${fullName} ${desc} ${extName} ${targetName}`.toLowerCase();
+    if (queryWords.every(word => haystack.includes(word))) {
+      const paramsCount = metadata.getParametersCount();
+      const params = [];
+      for (let p = 0; p < paramsCount; ++p) {
+        const param = metadata.getParameter(p);
+        params.push({
+          name: (param.getName && param.getName()) || `param${p}`,
+          type: param.getType(),
+          description: param.getDescription() || '',
+          optional: param.isOptional ? param.isOptional() : false,
+        });
+      }
+      matches.push({
+        name: type,
+        fullName,
+        type: kind,
+        extension: extName,
+        target: targetName || undefined,
+        description: desc,
+        parameters: params,
+      });
+    }
+  }
+};
