+    const allExtensions = platform.getAllPlatformExtensions();
+    const normalizedQuery = (query || '').trim().toLowerCase();
+    const queryWords = normalizedQuery.split(/\s+/).filter(Boolean);
+    if (queryWords.length === 0) return null;
+
+    const matches: Array<Object> = [];
+    const maxMatches = 25;
+
+    for (let i = 0; i < allExtensions.size(); ++i) {
+      if (matches.length >= maxMatches) break;
+      const ext = allExtensions.at(i);
+      const extName = ext.getName();
+
+      // Free actions and conditions
+      searchInstructionsInMap(
+        ext.getAllActions(),
+        'action',
+        extName,
+        '',
+        queryWords,
+        matches,
+        maxMatches
+      );
+      searchInstructionsInMap(
+        ext.getAllConditions(),
+        'condition',
+        extName,
+        '',
+        queryWords,
+        matches,
+        maxMatches
+      );
+
+      // Objects actions and conditions
+      const objectsTypes = ext.getExtensionObjectsTypes();
+      for (let o = 0; o < objectsTypes.size(); ++o) {
+        if (matches.length >= maxMatches) break;
+        const objType = objectsTypes.at(o);
+        searchInstructionsInMap(
+          ext.getAllActionsForObject(objType),
+          'action',
+          extName,
+          objType,
+          queryWords,
+          matches,
+          maxMatches
+        );
+        searchInstructionsInMap(
+          ext.getAllConditionsForObject(objType),
+          'condition',
+          extName,
+          objType,
+          queryWords,
+          matches,
+          maxMatches
+        );
+      }
+
+      // Behaviors actions and conditions
+      const behaviorsTypes = ext.getBehaviorsTypes();
+      for (let b = 0; b < behaviorsTypes.size(); ++b) {
+        if (matches.length >= maxMatches) break;
+        const behType = behaviorsTypes.at(b);
+        searchInstructionsInMap(
+          ext.getAllActionsForBehavior(behType),
+          'action',
+          extName,
+          behType,
+          queryWords,
+          matches,
+          maxMatches
+        );
+        searchInstructionsInMap(
+          ext.getAllConditionsForBehavior(behType),
+          'condition',
+          extName,
+          behType,
+          queryWords,
+          matches,
+          maxMatches
+        );
+      }
+
+      // Expressions
+      const expressions = ext.getAllExpressions();
+      if (expressions) {
+        const exprKeys = expressions.keys();
+        for (let j = 0; j < exprKeys.size(); ++j) {
+          if (matches.length >= maxMatches) break;
+          const key = exprKeys.at(j);
+          const metadata = expressions.get(key);
+          if (!metadata) continue;
+          const fullName = metadata.getFullName ? metadata.getFullName() || '' : '';
+          const desc = metadata.getDescription ? metadata.getDescription() || '' : '';
+          const haystack = `${key} ${fullName} ${desc} ${extName}`.toLowerCase();
+          if (queryWords.every(word => haystack.includes(word))) {
+            matches.push({
+              name: key,
+              fullName,
+              type: 'expression',
+              extension: extName,
+              description: desc,
+            });
+          }
+        }
+      }
+    }
+
+    return {
+      success: true,
+      query,
+      count: matches.length,
+      results: matches,
+      ...(matches.length === 0
+        ? {
+            message: `No engine actions, conditions, or expressions matched "${query}".`,
+          }
+        : {}),
+    };
+  } catch (error) {
+    console.warn('[BYOK] Local documentation reflection failed:', error);
+    return null;
+  }
+};
